#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <RTClib.h>
#include <EEPROM.h>
#include "DHT.h"

#define DHTPIN 2
#define DHTTYPE DHT22
#define LDR A0
#define BTN 3
#define LED_OK 12
#define LED_ALERTA 11
#define LED_CRITICO 10
#define BUZZER 9

DHT dht(DHTPIN,DHTTYPE);
LiquidCrystal_I2C lcd(0x27,16,2);
RTC_DS1307 rtc;

bool pt=true;
const int UTC=0;

float temp=0,umid=0;
int luz=0,tela=0,addr=0,ldrMin=1023,ldrMax=0;

unsigned long tLeitura,tTela,tBtn,tBuzz,tLog;

const float TMIN=10,TMAX=16,TCRITMIN=7,TCRITMAX=19;
const float UMIN=60,UMAX=80,UCRITMIN=50,UCRITMAX=90;
const int LOK=30,LALERTA=60;
const unsigned long T_LEIT=10000,T_TELA=3000,T_BUZZ=5000,T_LOG=60000;

byte t1[8]={B00111,B01000,B01000,B11111,B11111,B11111,B11111,B01111};
byte t2[8]={B11100,B00010,B00010,B11111,B11111,B11111,B11111,B11110};
byte gota[8]={B00100,B00100,B01010,B01010,B10001,B10001,B10001,B01110};
byte sol[8]={B00100,B10101,B01110,B11111,B01110,B10101,B00100,B00000};

void setup(){
  Serial.begin(9600);
  pinMode(LED_OK,OUTPUT);
  pinMode(LED_ALERTA,OUTPUT);
  pinMode(LED_CRITICO,OUTPUT);
  pinMode(BUZZER,OUTPUT);
  pinMode(BTN,INPUT_PULLUP);
  dht.begin();
  lcd.init();
  lcd.backlight();
  lcd.createChar(0,t1);
  lcd.createChar(1,t2);
  lcd.createChar(2,gota);
  lcd.createChar(3,sol);
  if(!rtc.begin()){
    lcd.print("Erro RTC");
    while(true);
  }
  rtc.adjust(DateTime(F(__DATE__),F(__TIME__)));
  logo();
  calibrarLDR();
  lerSensores();
  analisar();
  telaLCD();
  Serial.println("Sistema iniciado");
}

void loop(){
  botaoIdioma();
  if(millis()-tLeitura>=T_LEIT){
    tLeitura=millis();
    lerSensores();
    analisar();
    buzzer();
    salvarLog();
    serialLog();
  }
  if(millis()-tTela>=T_TELA){
    tTela=millis();
    tela=(tela+1)%5;
    telaLCD();
  }
}
void logo(){
  lcd.clear();
  lcd.setCursor(0,0);
  lcd.print("Smart Solutions");
  lcd.setCursor(0,1);
  lcd.print("Vinheria Agn.");
  delay(2000);
  lcd.clear();
  lcd.print("Inicializando");
  for(int i=0;i<5;i++){
    lcd.print(".");
    delay(300);
  }
}
void calibrarLDR(){
  lcd.clear();
  lcd.print("Calibrando");
  for(int i=0;i<30;i++){
    int v=analogRead(LDR);
    ldrMin=min(ldrMin,v);
    ldrMax=max(ldrMax,v);
    delay(50);
  }
  if(ldrMax-ldrMin<20){
    ldrMin=0;
    ldrMax=1023;
  }
}

void lerSensores(){
  float t=dht.readTemperature();
  float u=dht.readHumidity();
  if(!isnan(t))temp=t;
  if(!isnan(u))umid=u;
  long soma=0;
  for(int i=0;i<10;i++){
    int raw=analogRead(LDR);
    ldrMin=min(ldrMin,raw);
    ldrMax=max(ldrMax,raw);
    soma+=constrain(
      map(raw,ldrMin,ldrMax,100,0),
      0,100
    );
    delay(20);
  }
  luz=soma/10;
}

bool tempOk(){return temp>=TMIN&&temp<=TMAX;}
bool tempCrit(){return temp<TCRITMIN||temp>TCRITMAX;}
bool umidOk(){return umid>=UMIN&&umid<=UMAX;}
bool umidCrit(){return umid<UCRITMIN||umid>UCRITMAX;}
bool luzOk(){return luz<=LOK;}
bool luzCrit(){return luz>LALERTA;}
bool ideal(){return tempOk()&&umidOk()&&luzOk();}
bool critico(){return tempCrit()||umidCrit()||luzCrit();}
bool alerta(){return !ideal()&&!critico();}

void analisar(){

  digitalWrite(LED_OK,ideal());
  digitalWrite(LED_ALERTA,alerta());
  digitalWrite(LED_CRITICO,critico());
}
void buzzer(){
  if(ideal()){
    noTone(BUZZER);
    return;
  }
  if(millis()-tBuzz>=T_BUZZ){
    tBuzz=millis();
    if(critico())
      tone(BUZZER,1000,800);
    else
      tone(BUZZER,600,500);
  }
}
DateTime agora(){
  return DateTime(rtc.now().unixtime()+UTC*3600);
}
void p2(int v){
  if(v<10)lcd.print("0");
  lcd.print(v);
}
void s2(int v){
  if(v<10)Serial.print("0");
  Serial.print(v);
}
void telaLCD(){
  lcd.clear();
  DateTime dt=agora();
  switch(tela){
    case 0:
      lcd.print(pt?"Data: ":"Date: ");
      p2(dt.day());lcd.print("/");
      p2(dt.month());lcd.print("/");
      lcd.print(dt.year());
      lcd.setCursor(0,1);
      lcd.print(pt?"Hora: ":"Time: ");
      p2(dt.hour());lcd.print(":");
      p2(dt.minute());lcd.print(":");
      p2(dt.second());
    break;
    case 1:
      lcd.print("Temp: ");
      lcd.print(temp,1);
      lcd.print((char)223);
      lcd.print("C");
      lcd.setCursor(0,1);
      lcd.print(
        tempOk()?"Ideal ~13C":
        tempCrit()?"TEMP CRITICA":
        "Ajustar temp."
      );
    break;
    case 2:
      lcd.print(pt?"Umidade: ":"Humidity: ");
      lcd.print(umid,0);
      lcd.print("% ");
      lcd.write(byte(2));
      lcd.setCursor(0,1);
      lcd.print(
        umidOk()?"Ideal 60-80%":
        umidCrit()?"UMID CRITICA":
        "Ajustar umid."
      );
    break;
    case 3:
      lcd.print(pt?"Luz: ":"Light: ");
      lcd.print(luz);
      lcd.print("% ");
      lcd.write(byte(3));
      lcd.setCursor(0,1);
      lcd.print(
        luzOk()?"Penumbra":
        luzCrit()?"MUITA LUZ":
        "Luz alerta"
      );
    break;
    case 4:
      lcd.print(pt?"Status Adega":"Cellar Status");
      lcd.setCursor(0,1);
      lcd.print(
        ideal()?"Cond. Premium":
        critico()?"Risco vinho":
        "Atencao"
      );
    break;
  }
}

void botaoIdioma(){
  static bool ultimo=HIGH;
  bool leitura=digitalRead(BTN);
  if(ultimo==HIGH&&leitura==LOW){
    pt=!pt;
    lcd.clear();
    lcd.print("Idioma:");
    lcd.setCursor(0,1);
    lcd.print(pt?"Portugues":"English");
    delay(700);
    telaLCD();
  }
  ultimo=leitura;
}

void salvarLog(){
  if(ideal())return;
  if(millis()-tLog<T_LOG)return;
  tLog=millis();
  byte erro=0;
  if(!tempOk())erro+=1;
  if(!umidOk())erro+=2;
  if(!luzOk())erro+=4;
  DateTime dt=agora();
  EEPROM.put(addr,dt.unixtime());
  EEPROM.put(addr+4,int(temp*100));
  EEPROM.put(addr+6,int(umid*100));
  EEPROM.put(addr+8,byte(luz));
  EEPROM.put(addr+9,erro);
  addr+=10;
  if(addr>=1000)addr=0;
}

void serialLog(){
  DateTime dt=agora();
  Serial.print("Leitura ");
  s2(dt.day());Serial.print("/");
  s2(dt.month());Serial.print("/");
  Serial.print(dt.year());Serial.print(" ");
  s2(dt.hour());Serial.print(":");
  s2(dt.minute());Serial.print(":");
  s2(dt.second());
  Serial.print(" | Temp: ");
  Serial.print(temp,1);
  Serial.print("C | Umid: ");
  Serial.print(umid,0);
  Serial.print("% | Luz: ");
  Serial.print(luz);
  Serial.print("% | Status: ");
  Serial.println(
    ideal()?"IDEAL":
    critico()?"CRITICO":
    "ALERTA"
  );
}
